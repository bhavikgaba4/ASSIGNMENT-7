        this->left = NULL;
        this->right = NULL;
    }
};
node *createbst(node *root, int d){
    if (root==NULL){
         root = new node (d);
        return root;
    }
    if(d<root->data){
        root->left = createbst(root->left, d);
        return root;
    }
    else{
        root->right = createbst(root->right, d);
        return root;
    }
}
